{
  "name": "apiflow-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @junixlabs/apiflow-runner",
    "dev:mcp": "tsx packages/runner/src/mcp/server.ts",
    "build": "tsc -b && npm run build -w @junixlabs/apiflow-runner",
    "start": "node packages/cli/bin/cli.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundary": "depcruise --config .dependency-cruiser.cjs packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.11"
  }
}
